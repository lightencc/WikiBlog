<header class="site-header <%= pageKind === 'post' ? 'site-header-reading' : '' %>" data-site-header>
  <div class="header-shell">
    <div class="header-top">
      <div class="brand-cluster">
        <span class="brand-kicker">Reading Recall</span>
        <a class="brand-link" href="/" accesskey="h" title="<%= siteConfig.siteName %> (Alt + H)">
          <%= siteConfig.siteName %>
        </a>
      </div>

      <div class="header-actions">
        <a
          class="header-search-link <%= pageKind === 'search' ? 'is-active' : '' %>"
          href="/search/"
          aria-label="搜索回看笔记"
          <%- pageKind === 'search' ? 'aria-current="page"' : '' %>
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span>搜索</span>
        </a>

        <button id="theme-toggle" class="theme-toggle" accesskey="t" title="切换主题 (Alt + T)" aria-label="Toggle theme">
          <svg id="moon" width="24" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
          </svg>
          <svg id="sun" width="24" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>
      </div>
    </div>

    <% if (themeTabs && themeTabs.length > 0 && pageKind !== 'post') { %>
      <nav class="theme-tabs" aria-label="主题导航">
        <div class="theme-tab-list">
          <% themeTabs.forEach((item) => { %>
            <a
              href="<%= item.href %>"
              class="theme-tab <%= item.isActive ? 'is-active' : '' %>"
              <%- item.isActive ? 'aria-current="page"' : '' %>
            >
              <span><%= item.label %></span>
            </a>
          <% }) %>
        </div>
      </nav>
    <% } %>
 </div>
</header>
