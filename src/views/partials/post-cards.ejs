<% if (!posts || posts.length === 0) { %>
  <p class="post-empty"><%= emptyMessage || "暂无文章。" %></p>
<% } %>

<% (posts || []).forEach((post) => { %>
  <article class="post-entry">
    <a class="post-card-link <%= post.listCoverImage ? 'has-thumb' : '' %>" aria-label="post link to <%= post.title %>" href="/posts/<%= post.slug %>/">
      <div class="entry-main">
        <div class="entry-overline">
          <span class="entry-note">AI整理摘要</span>
          <% if (post.source && (post.source.name || post.source.platform)) { %>
            <span class="entry-dot" aria-hidden="true"></span>
            <span class="entry-source"><%= post.source.name || post.source.platform %></span>
          <% } %>
        </div>

        <header class="entry-header">
          <h2 class="entry-hint-parent"><%= post.title %></h2>
        </header>

        <div class="entry-content">
          <p><%= post.summary %></p>
        </div>

        <% if ((post.categories && post.categories.length > 0) || (post.tags && post.tags.length > 0) || post.language) { %>
          <div class="entry-tags" aria-label="文章标签">
            <% if (post.categories && post.categories.length > 0) { %>
              <span class="entry-tag entry-tag-accent"><%= post.categories[0] %></span>
            <% } %>
            <% (post.tags || []).slice(0, 3).forEach((tag) => { %>
              <span class="entry-tag">#<%= tag %></span>
            <% }) %>
            <% if (post.language && String(post.language).toLowerCase() !== "zh") { %>
              <span class="entry-tag"><%= String(post.language).toUpperCase() %></span>
            <% } %>
          </div>
        <% } %>

        <footer class="entry-footer">
          <time class="entry-published" datetime="<%= post.publishedAt %>"><%= formatDate(post.publishedAt) %></time>
          <span class="entry-footer-meta">
            <span><%= post.readingTimeMinutes %> 分钟</span>
            <span class="entry-dot" aria-hidden="true"></span>
            <span><%= post.wordCount %> 字</span>
          </span>
        </footer>
      </div>

      <% if (post.listCoverImage) { %>
        <figure class="entry-thumb">
          <img loading="lazy" src="<%= post.listCoverImage %>" alt="<%= post.title %>" />
        </figure>
      <% } %>
    </a>
  </article>
<% }) %>
