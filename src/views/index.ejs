<%- include("partials/head", { pageTitle, pageDescription, siteConfig }) %>
<body class="app-shell list page-<%= pageKind %>" id="top">
<%- include("partials/header", { siteConfig, primaryNavItems, pageKind, themeTabs, activeThemeSlug }) %>

<main class="main main-feed">
  <% if ((pageKind === 'home' || pageKind === 'category-feed') && featuredTags.length > 0) { %>
    <section class="page-subnav">
      <div class="page-subnav-row">
        <p class="hero-chip-label">热门标签</p>
        <div class="hero-chip-row">
          <% featuredTags.slice(0, 6).forEach((tag) => { %>
            <a class="hero-chip" href="<%= tag.href %>">#<%= tag.name %></a>
          <% }) %>
        </div>
      </div>
    </section>
  <% } else if (pageKind === 'tag-feed' && featuredCategories.length > 0) { %>
    <section class="page-subnav">
      <div class="hero-chip-block">
        <p class="hero-chip-label">相关主题</p>
        <div class="hero-chip-row">
          <% featuredCategories.forEach((category) => { %>
            <a class="hero-chip hero-chip-soft" href="<%= category.href %>"><%= category.name %></a>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <section class="feed-section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Recall Feed</p>
        <h2><%= pageSectionTitle || "最新回看" %></h2>
      </div>
      <% if (pageSectionHint) { %>
        <span class="section-badge"><%= pageSectionHint %></span>
      <% } %>
    </div>

    <%- include("partials/post-cards", { posts, formatDate, emptyMessage }) %>
  </section>
</main>

<%- include("partials/footer", { siteConfig }) %>
