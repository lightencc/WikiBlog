<%- include("partials/head", { pageTitle, pageDescription, siteConfig }) %>
<body class="app-shell page-post" id="top">
<%- include("partials/header", { siteConfig, primaryNavItems, pageKind, themeTabs, activeThemeSlug }) %>

<main class="main main-post">
  <article class="post-shell">
    <section class="post-column">
      <header class="post-hero-card">
        <p class="post-kicker"><%= sourceCta ? sourceCta.platformLabel : "Reading Recall" %></p>
        <h1 class="post-title entry-hint-parent"><%= post.title %></h1>
        <% if (post.summary) { %>
          <p class="post-dek"><%= post.summary %></p>
        <% } %>

        <div class="post-processing-note">
          <span class="post-processing-badge">AI整理摘要</span>
          <p>以下内容为 AI 基于原文整理的回看笔记，方便先快速恢复上下文；若要核对细节或继续深读，可直接打开原文。</p>
        </div>

        <div class="post-meta-row">
          <span title="<%= post.publishedAt %>"><%= formatDate(post.publishedAt) %></span>
          <span class="post-meta-dot" aria-hidden="true"></span>
          <span><%= post.readingTimeMinutes %> 分钟</span>
          <span class="post-meta-dot" aria-hidden="true"></span>
          <span><%= post.wordCount %> 字</span>
          <span class="post-meta-dot" aria-hidden="true"></span>
          <span><%= post.author %></span>
        </div>

        <% if (post.categoryRefs.length > 0 || post.tagRefs.length > 0 || (post.language && String(post.language).toLowerCase() !== "zh")) { %>
          <div class="post-hero-tags">
            <% if (post.language && String(post.language).toLowerCase() !== "zh") { %>
              <span class="post-chip"><%= String(post.language).toUpperCase() %></span>
            <% } %>
            <% post.categoryRefs.slice(0, 2).forEach((item) => { %>
              <a class="post-chip post-chip-accent" href="/categories/<%= item.slug %>/"><%= item.name %></a>
            <% }) %>
            <% post.tagRefs.slice(0, 6).forEach((item) => { %>
              <a class="post-chip" href="/tags/<%= item.slug %>/">#<%= item.name %></a>
            <% }) %>
          </div>
        <% } %>

        <% if (sourceCta) { %>
          <a
            class="source-cta"
            data-source-cta
            data-label-default="<%= sourceCta.label %>"
            data-label-open="正在打开原文..."
            href="<%= sourceCta.url %>"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="source-cta-copy">
              <span class="source-cta-eyebrow"><%= sourceCta.platformLabel %></span>
              <span class="source-cta-label"><%= sourceCta.label %></span>
              <span class="source-cta-meta"><%= sourceCta.sourceName %></span>
            </span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17 17 7"></path>
              <path d="M8 7h9v9"></path>
            </svg>
          </a>
        <% } %>
      </header>

      <% if (post.toc.length > 0) { %>
        <div class="post-mobile-toc">
          <div class="rail-card toc-card">
            <details>
              <summary accesskey="c" title="目录 (Alt + C)">
                <span class="details">目录</span>
              </summary>
              <div class="inner">
                <ul>
                  <% post.toc.forEach((item) => { %>
                    <li class="toc-depth-<%= item.depth %>">
                      <a href="#<%= item.id %>" aria-label="<%= item.text %>"><%= item.text %></a>
                    </li>
                  <% }) %>
                </ul>
              </div>
            </details>
          </div>
        </div>
      <% } %>

      <% if (post.coverImage) { %>
        <figure class="post-cover">
          <img loading="eager" src="<%= post.coverImage %>" alt="<%= post.title %>" />
        </figure>
      <% } %>

      <section class="post-content-card">
        <div class="post-content"><%- post.contentHtml %></div>
      </section>

      <% if (prev || next) { %>
        <nav class="paginav post-mobile-nav">
          <% if (prev) { %>
            <a class="prev" href="/posts/<%= prev.slug %>/">
              <span class="title">上一条</span>
              <span><%= prev.title %></span>
            </a>
          <% } %>
          <% if (next) { %>
            <a class="next" href="/posts/<%= next.slug %>/">
              <span class="title">下一条</span>
              <span><%= next.title %></span>
            </a>
          <% } %>
        </nav>
      <% } %>
    </section>

    <aside class="post-rail">
      <% if (post.toc.length > 0) { %>
        <section class="rail-card toc-card rail-desktop-toc">
          <details open>
            <summary>
              <span class="details">目录</span>
            </summary>
            <div class="inner">
              <ul>
                <% post.toc.forEach((item) => { %>
                  <li class="toc-depth-<%= item.depth %>">
                    <a href="#<%= item.id %>" aria-label="<%= item.text %>"><%= item.text %></a>
                  </li>
                <% }) %>
              </ul>
            </div>
          </details>
        </section>
      <% } %>

      <% if (post.source && post.source.url) { %>
        <section class="rail-card">
          <p class="rail-label">来源</p>
          <a class="rail-source-link" href="<%= post.source.url %>" target="_blank" rel="noopener noreferrer">
            <%= post.source.name || post.source.url %>
          </a>
          <% if (post.source.platform) { %>
            <p class="rail-note"><%= post.source.platform %></p>
          <% } %>
        </section>
      <% } %>

      <% if (post.categoryRefs.length > 0 || post.tagRefs.length > 0) { %>
        <section class="rail-card">
          <p class="rail-label">标签归档</p>
          <div class="rail-chip-group">
            <% post.categoryRefs.forEach((item) => { %>
              <a class="post-chip post-chip-accent" href="/categories/<%= item.slug %>/"><%= item.name %></a>
            <% }) %>
            <% post.tagRefs.forEach((item) => { %>
              <a class="post-chip" href="/tags/<%= item.slug %>/">#<%= item.name %></a>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if (prev || next) { %>
        <nav class="rail-card rail-pagination">
          <% if (prev) { %>
            <a class="prev" href="/posts/<%= prev.slug %>/">
              <span class="title">上一条</span>
              <span><%= prev.title %></span>
            </a>
          <% } %>
          <% if (next) { %>
            <a class="next" href="/posts/<%= next.slug %>/">
              <span class="title">下一条</span>
              <span><%= next.title %></span>
            </a>
          <% } %>
        </nav>
      <% } %>
    </aside>
  </article>
</main>

<%- include("partials/footer", { siteConfig }) %>
